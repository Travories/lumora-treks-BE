# ==============================================================================
# Lumora Treks CMS Backend — Environment Configuration Template
# ==============================================================================

# Environment Mode: 'production' (or 'prod') | 'development' (or 'dev')
ENVIRONMENT=development

# Django Settings
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,apilumora.rivetsoft.com

# Database Connection (PostgreSQL or fallback SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/lumora

# Service Base URLs
WAGTAILADMIN_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Google Identity Services OAuth 2.0 web client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Lumora API tokens expire server-side after this many days
AUTH_TOKEN_TTL_DAYS=30

# External Redis Cache (set your hosted Redis connection URL)
ENABLE_REDIS=true
REDIS_URL=redis://169.58.20.46:6382/1

# S3 Object Storage (Set ENABLE_S3=true/false)
ENABLE_S3=true
AWS_S3_ENDPOINT_URL=https://garage.travories.com
AWS_S3_REGION_NAME=garage
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_STORAGE_BUCKET_NAME=lumoratreks

# CORS & CSRF Trusted Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://lumora.rivetsoft.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://apilumora.rivetsoft.com,https://lumora.rivetsoft.com
